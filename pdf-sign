def print_how_to_automate_this_call(args, steps, pageCount):
    txt=["pdf-sign"]
    JOIN, SP, NBSP = object(), object(), object()
    state = SP
    def add(*things):
        nonlocal txt, state
        for thing in things:
            if thing in [JOIN, SP, NBSP]:
                state = thing
                continue
            is_short = len(thing)==2 and thing.startswith('-')
            if state == JOIN:
                txt[-1] += thing[1:] if is_short else thing
            elif state == SP:
                txt.append(thing)
            else:
                txt[-1]+=f' {thing}'
            state = JOIN if is_short else SP
    # -f
    if not args.flatten: add('--no-flatten')
    # -e
    if args.existing != 'backup': add('-e', args.existing)
    # -c
    if args.continue_on_warnings: add('-c')
    # steps
    def f(fl):
        i=0
        while not math.isclose(fl, round(fl, i)):
            i+=1
        ret = str(round(fl, i))
        if ret.endswith(".0"): return ret[:-2]
        return ret
    def p(path):
        home = os.path.expanduser("~/")
        if path.startswith(home):
            return f'~/{shlex.quote(path[len(home):])}'
        else:
            return shlex.quote(path)
    for i, s in enumerate(steps):
        if i: add('-n')
        add('-b')
        if s.batch:
            if s.page != -1: add('-p', str(s.page))
            if s.signature: add('-s', NBSP, p(s.signature))
            if s.text: add('-t', shlex.quote(s.text[0]), SP)
            if s.x_coordinate != 'C': add('-x', s.x_coordinate)
            if s.y_coordinate != 'B-25%': add('-y', s.y_coordinate)
            if s.anchor != 'C': add('-a', s.anchor)
            if s.resize_factor != 1.0: add('-r', f(s.resize_factor))
            if s.width != '50%': add('-W', s.width)
            if s.height != '50%': add('-H', s.height)
        else:
            # -p
            if s.pageNumber() != pageCount:
                add('-p', str(s.pageNumber()))
            # -st
            (signType, _, content)=s.signatures[s.signatureIndex()]
            if signType=='cell':
                (signType, _, content)=content()
            if signType == 'file':
                add('-s', NBSP, p(content))
            else:
                add('-t', shlex.quote(content), SP)
            # -xy
            if s.signaturePositionX() != 0.5:
                add('-x', f'{f(s.signaturePositionX()*100)}%')
            if s.signaturePositionY() != 0.75:
                add('-y', f'{f(s.signaturePositionY()*100)}%')
            # -a
            if s.anchor != 'C': add('-a', s.anchor)
            # -rWH
            resize_r, resize_w, resize_h = s.defaultResizeFactor()
            resize = min(resize_r, resize_w, resize_h)
            scale = 1.1**s.signatureScale()
            (signature_width, signature_height)=s.signatureSize()
            (page_width, page_height)=s.pageSize()
            resize_tot = resize * scale
            w = signature_width/page_width*resize_tot
            h = signature_height/page_height*resize_tot
            c=math.ceil
            if resize == resize_r:
                if resize_tot != 1:
                    add('-r', f(resize_tot))
                if w > 0.5:
                    add('-W', f'{f(c(w)*100)}%')
                if h > 0.5:
                    add('-H', f'{f(c(h)*100)}%')
            else:
                if resize_tot > 1:
                    add('-r', f(c(resize_tot)))
                arg, opt, resize_d, other_opt, other_factor = (
                    (s.width, '-W', resize_w, '-H', h)
                    if resize == resize_w else
                    (s.height, '-H', resize_h, '-W', w))
                if scale == 1:
                    if arg != '50%':
                        add(opt, arg)
                else:
                    add(opt, f'{f(resize_d*scale*100)}%')
                if other_factor > 0.5:
                    add(other_opt, f'{f(c(other_factor)*100)}%')
    # -o
    if args.output: add('-o', NBSP, p(args.output))
    # input
    add(SP, p(args.input))
    # print
    pre = "How to automate this:"
    cols = shutil.get_terminal_size().columns
    oneline = ' '.join([pre, *txt])
    if len(oneline) < cols:
        print(oneline)
    else:
        print(pre)
        print('  ', end='')
        rem = cols - 4
        while txt:
            [thing, *txt] = txt
            print(thing, end='')
            rem -= len(thing)
            if txt and rem < len(txt[0]) + 4:
                print(' \\\n    ', end='')
                rem = cols - 6
            elif txt:
                print(' ', end='')
        print('')

main(parsed_args)
